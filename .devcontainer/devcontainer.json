// Dev container for agentic development on tbd with beads (bd), git and Claude Code.
// See README.md in this folder for what this file does and the safety model.
{
  "name": "tbd-dev",

  "build": { "dockerfile": "Dockerfile" },

  // Everything runs as this non-root user, which has no sudo.
  "remoteUser": "vscode",
  "containerUser": "vscode",

  // Extra hardening passed to `docker run`:
  //  - drop all Linux capabilities and block privilege escalation
  //  - send bd's usage-metrics hostname nowhere (belt and braces with the env vars below)
  "runArgs": [
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges",
    "--add-host=gastownhall-eventsapi.com=127.0.0.1",
    "--add-host=gastownhall-eventsapi.com=::1"
  ],

  // Claude Code's login and settings live in a Docker volume, NOT your Mac's
  // ~/.claude. It survives container rebuilds; each project gets its own.
  "mounts": [
    "source=claude-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=${localWorkspaceFolder}/.snagboat/claude-projects,target=/home/vscode/.claude/projects,type=bind"
  ],

  "containerEnv": {
    "BD_DISABLE_METRICS": "1",
    "DO_NOT_TRACK": "1",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    // Linux build of stella-core, kept apart from the Mac's stella-core/build/.
    "TBD_STELLA_CORE": "${containerWorkspaceFolder}/stella-core/build-linux/shim/stella_core",
    // Local models run in Ollama on the Mac (GPU); the container calls it over
    // the network rather than running models itself (CPU-only in Docker).
    "OLLAMA_HOST": "http://host.docker.internal:11434"
  },

  "remoteEnv": {
    // Don't hand your Mac's SSH keys (via the forwarded ssh-agent) to code in
    // the container. See README "Pushing to GitHub".
    "SSH_AUTH_SOCK": ""
  },

  // Runs once when the container is created.
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  // Runs every time the container starts: checks that nothing has set up git
  // hooks that would run on your Mac.
  "postStartCommand": "git config --global --get-all safe.directory 2>/dev/null | grep -qxF \"${containerWorkspaceFolder}\" || git config --global --add safe.directory \"${containerWorkspaceFolder}\"; bash .devcontainer/check-host-safety.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-python.python"
      ]
    }
  },

  "features": {
    // GitHub CLI, for PRs. Needs its own login: see README "Pushing to GitHub".
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}"
}
